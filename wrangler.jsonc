{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tupiniquim-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "tupiniquim-cms-drafts",
      "database_id": "29919be9-f82c-44c5-907f-8f8c76c2409d"
    }
  ]
}
