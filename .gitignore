# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# OpenNext / Cloudflare build output
.open-next/
.wrangler/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.aider*
!.env.example

# local recovery files
*.backup
*.backup.*
*.pre-*.backup
*.pre-*.backup.*

# transactional Context Engine artifacts
/site-context/.generation-tmp/

# Arquivos locais, fontes brutas e verificacoes sensiveis
/CODIGO_PROJETO_TUPINIQUIM.txt
/MAPA_INICIAL_PROJETO.txt
/ROADMAP_ESTUDO_AUTONOMO.txt
/VERIFICACAO_CREDENCIAIS.txt
/content/inbox/
/scripts/governance/materialize-editorial-mvp-governance.js
/scripts/governance/materialize-editorial-mvp-governance.test.js
